@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISubscriptionService SubscriptionService
@inject ITenantAccessRepository TenantAccessRepository

<nav class="qb-nav" aria-label="Navegación principal">
    <a class="brand" href="dashboard">
        <img class="brand-logo" src="images/fidelis-logo.png" alt="Fidelis Financial Management" />
        <span>Fidelis Financial Management</span>
    </a>

    @if (accessibleTenants.Count > 1)
    {
        <details class="tenant-switcher">
            <summary class="tenant-switcher-current">@CurrentTenantName</summary>
            <div class="tenant-switcher-options">
                @foreach (var tenant in accessibleTenants)
                {
                    <form method="post" action="@($"/switch-tenant/{tenant.TenantId}")">
                        <AntiforgeryToken />
                        <button type="submit" class="tenant-switcher-option" disabled="@(tenant.TenantId == activeTenantId)">
                            @tenant.TenantName
                        </button>
                    </form>
                }
            </div>
        </details>
    }

    <a class="create-button" href="ingresos">
        <span aria-hidden="true">+</span>
        Nuevo ingreso
    </a>

    <div class="nav-section">
        @if (HasFeature(CfsFeatures.Dashboard) && CanSee("dashboard"))
        {
            <NavLink class="nav-link" href="dashboard">
                <span class="nav-icon" aria-hidden="true">⌂</span>
                Dashboard
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.Income) && CanSee("ingresos"))
        {
            <NavLink class="nav-link" href="ingresos">
                <span class="nav-icon" aria-hidden="true">$</span>
                Ingresos
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.Expenses) && CanSee("egresos"))
        {
            <NavLink class="nav-link" href="egresos">
                <span class="nav-icon" aria-hidden="true">−</span>
                Egresos
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.Checks) && CanSee("cheques"))
        {
            <NavLink class="nav-link" href="cheques">
                <span class="nav-icon" aria-hidden="true">▤</span>
                Cheques
            </NavLink>
            <NavLink class="nav-link" href="configuracion/cheques">
                <span class="nav-icon" aria-hidden="true">⚙</span>
                Formato de cheques
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.Deposits) && CanSee("depositos"))
        {
            <NavLink class="nav-link" href="depositos">
                <span class="nav-icon" aria-hidden="true">⇣</span>
                Depósitos
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.Reconciliation) && CanSee("conciliacion"))
        {
            <NavLink class="nav-link" href="conciliacion">
                <span class="nav-icon" aria-hidden="true">✓</span>
                Conciliación
            </NavLink>
        }
        @if (HasFeature(CfsFeatures.ReportsBasic) && CanSee("reportes"))
        {
            <NavLink class="nav-link" href="reportes">
                <span class="nav-icon" aria-hidden="true">▥</span>
                Reportes
            </NavLink>
        }
        @if (subscription is not null && subscription.IsFounderAccount && CanSee("presupuesto"))
        {
            <NavLink class="nav-link" href="presupuesto">
                <span class="nav-icon" aria-hidden="true">◱</span>
                Presupuesto
            </NavLink>
        }
        @if (subscription is not null && !subscription.IsFounderAccount && CanSee("plan"))
        {
            <NavLink class="nav-link" href="configuracion/plan">
                <span class="nav-icon" aria-hidden="true">★</span>
                Plan y Add-ons
            </NavLink>
        }
    </div>

    @if (ShowAdminCenter)
    {
        <div class="nav-section admin-section">
            <span class="nav-section-label">Admin Center</span>
            @if (HasFeature(CfsFeatures.Audit) && CanSee("auditoria"))
            {
                <NavLink class="nav-link" href="auditoria">
                    <span class="nav-icon" aria-hidden="true">⏱</span>
                    Auditoría
                </NavLink>
            }
            @if (HasFeature(CfsFeatures.TrendAnalysis) && CanSee("tendencias"))
            {
                <NavLink class="nav-link" href="tendencias">
                    <span class="nav-icon" aria-hidden="true">📈</span>
                    Tendencias
                </NavLink>
            }
            @if (HasFeature(CfsFeatures.Automation) && CanSee("automatizaciones"))
            {
                <NavLink class="nav-link" href="automatizaciones">
                    <span class="nav-icon" aria-hidden="true">⟲</span>
                    Automatizaciones
                </NavLink>
            }
            @if (isAdmin)
            {
                <NavLink class="nav-link" href="usuarios">
                    <span class="nav-icon" aria-hidden="true">👥</span>
                    Usuarios
                </NavLink>
            }
            @if (isFounderAdmin)
            {
                <NavLink class="nav-link" href="admin/signups">
                    <span class="nav-icon" aria-hidden="true">⚑</span>
                    Signups
                </NavLink>
            }
        </div>
    }

    <div class="nav-footer">
        <a class="nav-footer-link" href="mailto:soporte@fidelisfm.com">
            <span class="nav-icon" aria-hidden="true">?</span>
            Soporte
        </a>
        <span class="nav-footer-version">Fidelis Financial Management</span>
    </div>
</nav>

@code {
    private TenantSubscription? subscription;
    private bool isFounderAdmin;
    private bool isAdmin;
    private bool isTesorero;
    private bool isAuditor;
    private IReadOnlyList<TenantAccessOption> accessibleTenants = [];
    private int activeTenantId;
    private string CurrentTenantName =>
        accessibleTenants.FirstOrDefault(t => t.TenantId == activeTenantId)?.TenantName ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        subscription = await SubscriptionService.GetCurrentAsync(authState.User);
        isFounderAdmin = authState.User.FindFirst("TenantId")?.Value == "1" && authState.User.IsInRole("Administrador");
        isAdmin = authState.User.IsInRole("Administrador");
        isTesorero = authState.User.IsInRole("Tesorero");
        isAuditor = authState.User.IsInRole("Auditor");

        activeTenantId = int.TryParse(authState.User.FindFirst("TenantId")?.Value, out var tenantId) ? tenantId : 1;
        var userId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        try
        {
            accessibleTenants = await TenantAccessRepository.GetAccessibleTenantsAsync(userId);
        }
        catch (Exception)
        {
            // Keeps the shared layout (and every page that uses it) usable even if the
            // UserTenantAccess/TenantNetworks tables aren't provisioned yet in this environment.
            accessibleTenants = [];
        }
    }

    private bool HasFeature(string featureKey) =>
        subscription?.HasFeature(featureKey) ?? true;

    // Avoids rendering an orphan "Admin Center" label when the current role
    // (e.g. Tesorero) can't see any of the items grouped underneath it.
    private bool ShowAdminCenter =>
        (HasFeature(CfsFeatures.Audit) && CanSee("auditoria")) ||
        (HasFeature(CfsFeatures.TrendAnalysis) && CanSee("tendencias")) ||
        (HasFeature(CfsFeatures.Automation) && CanSee("automatizaciones")) ||
        isAdmin ||
        isFounderAdmin;

    // Returns true if the current user's role allows seeing this section.
    // Users with no role assigned (legacy "Finanzas" role) see all non-admin sections.
    private bool CanSee(string section)
    {
        if (isAdmin) return true;
        var legacy = IsLegacyRole();
        return section switch
        {
            // Auditor: only these sections visible
            "ingresos" or "egresos" => isTesorero || isAuditor || legacy,
            "auditoria" => isAuditor,

            // Tesorero + legacy — NOT auditor, NOT admin-only
            "dashboard" or "cheques" or "depositos" or "conciliacion" or "reportes" or "plan" or "presupuesto" =>
                isTesorero || legacy,

            // Administrador only
            "tendencias" or "automatizaciones" => false,

            _ => isTesorero || legacy
        };
    }

    private bool IsLegacyRole() => !isAdmin && !isTesorero && !isAuditor;
}
