@page "/auditoria"
@attribute [Authorize(Roles = "Administrador,Auditor")]
@rendermode InteractiveServer
@inject IAuditLogRepository AuditLogRepository
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISubscriptionService SubscriptionService

<PageTitle>Fidelis Auditoría</PageTitle>

<div class="screen-header">
    <div>
        <p class="eyebrow">Control</p>
        <h1>Auditoría</h1>
    </div>
    <div class="quick-actions">
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">Actualizar</button>
    </div>
</div>

@if (isLoadingAccess)
{
    <div class="status-panel">Cargando permisos...</div>
}
else if (!hasAccess)
{
    <section class="ai-advisor-shell">
        <div class="ai-empty-state">
            <h2>Auditoría no disponible</h2>
            <p>Esta función pertenece al plan Pro o Multi-Iglesia.</p>
        </div>
    </section>
}
else if (isLoading)
{
    <div class="status-panel">Cargando historial de auditoría...</div>
}
else
{
    <div class="aud-toolbar">
        <div class="aud-search-box">
            <span class="aud-search-icon" aria-hidden="true">⌕</span>
            <input class="aud-search" placeholder="Buscar por usuario, módulo, referencia o detalle..."
                   value="@searchTerm" @oninput="OnSearchChanged" />
        </div>
        <select class="form-select aud-filter" @bind="actionFilter">
            <option value="">Todas las acciones</option>
            @foreach (var action in DistinctActions)
            {
                <option value="@action">@action</option>
            }
        </select>
    </div>

    @if (entries.Count == 0)
    {
        <div class="aud-empty">
            <span class="aud-empty-icon">🕘</span>
            <p>Todavía no hay actividad registrada.</p>
        </div>
    }
    else if (FilteredEntries.Count == 0)
    {
        <div class="aud-empty">
            <span class="aud-empty-icon">🔍</span>
            <p>Ningún registro coincide con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="aud-list">
            @foreach (var entry in FilteredEntries)
            {
                var actionClass = ActionClass(entry.Action);
                <div class="aud-row">
                    <div class="aud-icon aud-icon--@actionClass">@ActionIcon(entry.Action)</div>
                    <div class="aud-main">
                        <div class="aud-line1">
                            <span class="aud-badge aud-badge--@actionClass">@entry.Action</span>
                            <span class="aud-module">@entry.EntityType</span>
                            @if (!string.IsNullOrWhiteSpace(entry.EntityReference))
                            {
                                <span class="aud-ref">#@entry.EntityReference</span>
                            }
                        </div>
                        <div class="aud-detail">@entry.Detail</div>
                    </div>
                    <div class="aud-meta">
                        <span class="aud-user">@entry.UserName</span>
                        <span class="aud-date">@entry.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool isLoadingAccess = true;
    private bool hasAccess;
    private bool isLoading = true;
    private IReadOnlyList<AuditLogEntry> entries = [];
    private string searchTerm = string.Empty;
    private string actionFilter = string.Empty;

    private IEnumerable<string> DistinctActions =>
        entries.Select(e => e.Action).Distinct().OrderBy(a => a);

    private IReadOnlyList<AuditLogEntry> FilteredEntries =>
        entries
            .Where(e => string.IsNullOrWhiteSpace(actionFilter) || e.Action == actionFilter)
            .Where(MatchesSearch)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hasAccess = await SubscriptionService.HasFeatureAsync(authState.User, CfsFeatures.Audit);
        isLoadingAccess = false;

        if (hasAccess)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        entries = await AuditLogRepository.GetRecentAsync();
        isLoading = false;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private bool MatchesSearch(AuditLogEntry entry)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        return Contains(entry.UserName) || Contains(entry.EntityType) ||
               Contains(entry.EntityReference) || Contains(entry.Detail);

        bool Contains(string? value) =>
            value is not null && value.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
    }

    private static string ActionClass(string action) => action.ToUpperInvariant() switch
    {
        "CREAR" => "create",
        "EDITAR" => "edit",
        "ANULAR" or "ELIMINAR" => "delete",
        "EJECUTAR" => "run",
        "IMPRIMIR" => "print",
        _ => "neutral"
    };

    private static string ActionIcon(string action) => action.ToUpperInvariant() switch
    {
        "CREAR" => "+",
        "EDITAR" => "✎",
        "ANULAR" or "ELIMINAR" => "🗑",
        "EJECUTAR" => "▶",
        "IMPRIMIR" => "🖶",
        _ => "•"
    };
}
