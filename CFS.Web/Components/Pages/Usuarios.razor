@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject IUserManagementRepository UserManagement
@inject ISubscriptionService SubscriptionService
@inject IEmailService EmailService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Usuarios — Fidelis</PageTitle>

<div class="um-header">
    <div>
        <h1 class="um-title">Usuarios</h1>
        <p class="um-subtitle">Gestiona los accesos de tu organización</p>
    </div>
    <button class="um-btn-new @(showCreateForm ? "um-btn-cancel" : "")" @onclick="ToggleForm">
        @if (showCreateForm)
        {
            <span>✕ Cancelar</span>
        }
        else
        {
            <span>+ Nuevo usuario</span>
        }
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="um-toast um-toast-success">
        <span class="um-toast-icon">✓</span>
        @successMessage
    </div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="um-toast um-toast-error">
        <span class="um-toast-icon">!</span>
        @errorMessage
    </div>
}

@if (showCreateForm)
{
    <div class="um-create-card">
        <div class="um-create-card-header">
            <span class="um-create-card-icon">👤</span>
            <h2 class="um-create-card-title">Nuevo usuario</h2>
        </div>
        <EditForm Model="@newUser" OnValidSubmit="CreateUserAsync" FormName="create-user">
            <DataAnnotationsValidator />
            <div class="um-form-grid">
                <div class="um-field">
                    <label class="um-label">Nombre</label>
                    <InputText @bind-Value="newUser.FirstName" class="um-input" placeholder="Nombre" />
                </div>
                <div class="um-field">
                    <label class="um-label">Apellido</label>
                    <InputText @bind-Value="newUser.LastName" class="um-input" placeholder="Apellido" />
                </div>
                <div class="um-field">
                    <label class="um-label">Usuario</label>
                    <InputText @bind-Value="newUser.UserName" class="um-input" placeholder="nombreusuario" autocomplete="off" />
                </div>
                <div class="um-field">
                    <label class="um-label">Correo electrónico</label>
                    <InputText @bind-Value="newUser.Email" class="um-input" placeholder="correo@iglesia.com" />
                </div>
                <div class="um-field">
                    <label class="um-label">Rol</label>
                    <InputSelect @bind-Value="newUser.Role" class="um-select">
                        <option value="Administrador">Administrador</option>
                        <option value="Tesorero">Tesorero</option>
                        <option value="Auditor">Auditor</option>
                    </InputSelect>
                </div>
            </div>
            <div class="um-form-actions">
                <button class="um-btn-primary" type="submit" disabled="@creating">
                    @(creating ? "Creando..." : "Crear usuario")
                </button>
                <button class="um-btn-ghost" type="button" @onclick="ToggleForm">Cancelar</button>
            </div>
        </EditForm>
    </div>
}

@if (users is null)
{
    <div class="um-loading">
        <div class="um-spinner"></div>
        <span>Cargando usuarios...</span>
    </div>
}
else if (users.Count == 0)
{
    <div class="um-empty">
        <span class="um-empty-icon">👥</span>
        <p>No hay usuarios registrados.</p>
    </div>
}
else
{
    <div class="um-user-list">
        @foreach (var u in users)
        {
            var initials = GetInitials(u.FullName);
            var roleColor = GetRoleColor(u.Roles);

            <div class="um-user-card @(!u.IsActive ? "um-user-card--inactive" : "")">
                <div class="um-user-avatar" style="--avatar-color: @roleColor">
                    @initials
                </div>
                <div class="um-user-info">
                    <div class="um-user-name">
                        @u.FullName
                        @if (u.Id == currentUserId)
                        {
                            <span class="um-pill um-pill--you">tú</span>
                        }
                        @if (u.MustChangePassword)
                        {
                            <span class="um-pill um-pill--pending">pendiente</span>
                        }
                    </div>
                    <div class="um-user-meta">
                        <span class="um-user-handle">@@@u.UserName</span>
                        @if (!string.IsNullOrWhiteSpace(u.Email))
                        {
                            <span class="um-meta-sep">·</span>
                            <span class="um-user-email">@u.Email</span>
                        }
                    </div>
                    <div class="um-user-roles">
                        @foreach (var role in u.Roles)
                        {
                            <span class="um-role-chip um-role-chip--@role.ToLower()">@role</span>
                        }
                    </div>
                </div>
                <div class="um-user-status">
                    <span class="um-status-dot @(u.IsActive ? "um-status-dot--active" : "um-status-dot--inactive")"></span>
                    <span class="um-status-label">@(u.IsActive ? "Activo" : "Inactivo")</span>
                </div>
                @if (u.Id != currentUserId)
                {
                    <div class="um-user-actions">
                        <button class="um-action-btn @(u.IsActive ? "um-action-btn--warn" : "um-action-btn--success")"
                                @onclick="() => ToggleActiveAsync(u)"
                                title="@(u.IsActive ? "Desactivar usuario" : "Activar usuario")">
                            @(u.IsActive ? "Desactivar" : "Activar")
                        </button>
                        <button class="um-action-btn um-action-btn--link"
                                @onclick="() => SendResetAsync(u)"
                                title="Enviar enlace para establecer contraseña"
                                disabled="@string.IsNullOrWhiteSpace(u.Email)">
                            Enviar enlace
                        </button>
                        <button class="um-action-btn um-action-btn--danger"
                                @onclick="() => ConfirmDelete(u)"
                                title="Eliminar usuario">
                            Eliminar
                        </button>
                    </div>
                }
                else
                {
                    <div class="um-user-actions"></div>
                }
            </div>
        }
    </div>
}

@if (deleteTarget is not null)
{
    <div class="um-modal-overlay" @onclick="() => deleteTarget = null">
        <div class="um-modal" @onclick:stopPropagation>
            <div class="um-modal-icon">🗑️</div>
            <h3 class="um-modal-title">¿Eliminar usuario?</h3>
            <p class="um-modal-body">
                Esta acción eliminará permanentemente a
                <strong>@deleteTarget.FullName</strong> (@deleteTarget.UserName)
                y no se puede deshacer.
            </p>
            <div class="um-modal-actions">
                <button class="um-btn-ghost" @onclick="() => deleteTarget = null">Cancelar</button>
                <button class="um-btn-danger" @onclick="DeleteUserAsync" disabled="@deleting">
                    @(deleting ? "Eliminando..." : "Sí, eliminar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<TenantUser>? users;
    private bool showCreateForm;
    private bool creating;
    private bool deleting;
    private string? successMessage;
    private string? errorMessage;
    private int currentUserId;
    private TenantUser? deleteTarget;

    private readonly UserCreateEntry newUser = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(
            authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        await LoadAsync();
    }

    private void ToggleForm()
    {
        showCreateForm = !showCreateForm;
        successMessage = null;
        errorMessage = null;
    }

    private async Task LoadAsync()
    {
        try
        {
            users = await UserManagement.GetUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la lista de usuarios: {ex.Message}";
            users = [];
        }
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(newUser.UserName))
        {
            errorMessage = "El nombre de usuario es requerido.";
            return;
        }

        creating = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            // Enforce the per-plan user limit (Básico 1, Standard 3, Pro 5; Founder unlimited).
            var limitAuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var subscription = await SubscriptionService.GetCurrentAsync(limitAuthState.User);
            var maxUsers = CfsPlans.MaxUsers(subscription.PlanKey);
            var currentCount = await UserManagement.GetUserCountAsync();
            if (currentCount >= maxUsers)
            {
                errorMessage = $"Tu plan {subscription.PlanName} permite hasta {maxUsers} usuario(s). Actualiza tu plan para agregar más.";
                return;
            }

            var result = await UserManagement.CreateUserAsync(newUser);

            if (!result.Saved)
            {
                errorMessage = result.ErrorMessage ?? "No se pudo crear el usuario.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(newUser.Email) && !string.IsNullOrWhiteSpace(result.ResetToken))
            {
                var baseUrl = Configuration["App:BaseUrl"]?.TrimEnd('/') ?? Nav.BaseUri.TrimEnd('/');
                var link = $"{baseUrl}/cambiar-contrasena?token={Uri.EscapeDataString(result.ResetToken)}";
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var orgName = authState.User.FindFirst("TenantName")?.Value ?? "tu iglesia";

                await EmailService.SendWelcomeAsync(
                    newUser.Email,
                    $"{newUser.FirstName} {newUser.LastName}".Trim(),
                    orgName,
                    link);

                successMessage = $"Usuario '{newUser.UserName}' creado y enlace de bienvenida enviado a {newUser.Email}.";
            }
            else
            {
                successMessage = $"Usuario '{newUser.UserName}' creado. Sin correo, no se envió enlace.";
            }

            newUser.FirstName = string.Empty;
            newUser.LastName = string.Empty;
            newUser.UserName = string.Empty;
            newUser.Email = string.Empty;
            newUser.Role = "Tesorero";
            showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear el usuario: {ex.Message}";
        }
        finally
        {
            creating = false;
        }
    }

    private async Task ToggleActiveAsync(TenantUser u)
    {
        successMessage = null;
        errorMessage = null;
        var ok = await UserManagement.SetActiveAsync(u.Id, !u.IsActive);
        if (ok)
        {
            successMessage = $"Usuario '{u.UserName}' {(!u.IsActive ? "activado" : "desactivado")}.";
            await LoadAsync();
        }
        else
        {
            errorMessage = "No se pudo actualizar el estado del usuario.";
        }
    }

    private async Task SendResetAsync(TenantUser u)
    {
        successMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(u.Email))
        {
            errorMessage = $"'{u.UserName}' no tiene correo electrónico registrado.";
            return;
        }

        var token = await UserManagement.GenerateResetTokenAsync(u.Id);
        if (token is null)
        {
            errorMessage = "No se pudo generar el enlace.";
            return;
        }

        var baseUrl = Configuration["App:BaseUrl"]?.TrimEnd('/') ?? Nav.BaseUri.TrimEnd('/');
        var link = $"{baseUrl}/cambiar-contrasena?token={Uri.EscapeDataString(token)}";
        await EmailService.SendPasswordResetAsync(u.Email, u.FullName, link);
        successMessage = $"Enlace de restablecimiento enviado a {u.Email}.";
    }

    private void ConfirmDelete(TenantUser u)
    {
        deleteTarget = u;
        successMessage = null;
        errorMessage = null;
    }

    private async Task DeleteUserAsync()
    {
        if (deleteTarget is null) return;
        deleting = true;
        var ok = await UserManagement.DeleteUserAsync(deleteTarget.Id);
        deleting = false;

        if (ok)
        {
            successMessage = $"Usuario '{deleteTarget.UserName}' eliminado.";
            deleteTarget = null;
            await LoadAsync();
        }
        else
        {
            errorMessage = "No se pudo eliminar el usuario.";
            deleteTarget = null;
        }
    }

    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : fullName.Length > 0 ? fullName[..Math.Min(2, fullName.Length)].ToUpper() : "?";
    }

    private static string GetRoleColor(IReadOnlyList<string> roles)
    {
        if (roles.Contains("Administrador")) return "#c8a44a";
        if (roles.Contains("Auditor")) return "#4a90c8";
        return "#4ac87a";
    }
}
